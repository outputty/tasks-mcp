{
  "name": "@outputty/tasks-mcp",
  "version": "0.3.0",
  "description": "outputty's task tracker as a local MCP server: a committed dependency graph synced two-way to GitHub Issues and Projects.",
  "type": "module",
  "bin": {
    "tasks-mcp": "bin/cli.ts"
  },
  "files": [
    "bin",
    "src",
    "README.md"
  ],
  "scripts": {
    "start": "bun run bin/cli.ts --http",
    "stdio": "bun run bin/cli.ts",
    "dev": "bun --hot run bin/cli.ts --http",
    "test": "bun test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "hono": "^4.6.14",
    "octokit": "^4.0.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "prettier": "^3.9.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
